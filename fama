<html lang="ar">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>تطبيق الربح من الإعلانات</title>
    <link rel="stylesheet" href="styles.css">
    <!-- Firebase SDK -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.5.0/firebase-app.js";
        import { getAnalytics } from "https://www.gstatic.com/firebasejs/11.5.0/firebase-analytics.js";
        import { getAuth, signInWithPopup, GoogleAuthProvider } from "https://www.gstatic.com/firebasejs/11.5.0/firebase-auth.js";
        import { getFirestore, doc, setDoc, getDoc } from "https://www.gstatic.com/firebasejs/11.5.0/firebase-firestore.js";

        // تكوين Firebase
        const firebaseConfig = {
            apiKey: "AIzaSyBbsDZwxHS1YnTPHrPcRq3WabCyi-FEGKw",
            authDomain: "fama-2e7f4.firebaseapp.com",
            projectId: "fama-2e7f4",
            storageBucket: "fama-2e7f4.firebasestorage.app",
            messagingSenderId: "934389763942",
            appId: "1:934389763942:web:86dd23a9c0682d8bc742a7",
            measurementId: "G-1BSS7S6QYW"
        };

        // Initialize Firebase
        const app = initializeApp(firebaseConfig);
        const analytics = getAnalytics(app);
        const auth = getAuth(app);
        const db = getFirestore(app);

        // تسجيل الدخول باستخدام جوجل
        const googleLoginButton = document.getElementById('google-login');
        googleLoginButton.addEventListener('click', async () => {
            const provider = new GoogleAuthProvider();
            try {
                const result = await signInWithPopup(auth, provider);
                const user = result.user;
                showNotification('تم تسجيل الدخول بنجاح!');
                loginPage.classList.add('hidden');
                mainPage.classList.remove('hidden');

                // حفظ بيانات المستخدم في Firestore
                const userRef = doc(db, 'users', user.uid);
                const userDoc = await getDoc(userRef);
                if (!userDoc.exists()) {
                    await setDoc(userRef, {
                        uid: user.uid,
                        email: user.email,
                        displayName: user.displayName,
                        photoURL: user.photoURL,
                        adPoints: 0,
                        followers: 0,
                        youtubePoints: 0,
                        vipPoints: 0,
                        referralPoints: 0,
                        level: 1,
                        dailyTasksCompleted: 0
                    });
                }
                updateStats(user.uid);
            } catch (error) {
                showNotification('حدث خطأ أثناء تسجيل الدخول: ' + error.message);
            }
        });

        // تحديث الإحصائيات
        async function updateStats(userId) {
            const userRef = doc(db, 'users', userId);
            const userDoc = await getDoc(userRef);
            if (userDoc.exists()) {
                const userData = userDoc.data();
                document.getElementById('ad-points').textContent = userData.adPoints;
                document.getElementById('followers').textContent = userData.followers;
                document.getElementById('youtube-points').textContent = userData.youtubePoints;
                document.getElementById('vip-points').textContent = userData.vipPoints;
                document.getElementById('referral-points').textContent = userData.referralPoints;
                document.getElementById('user-level').textContent = userData.level;

                // تحديث أشرطة التقدم
                document.getElementById('ad-progress').style.width = `${(userData.adPoints / 1000) * 100}%`;
                document.getElementById('followers-progress').style.width = `${(userData.followers / 500) * 100}%`;
                document.getElementById('youtube-progress').style.width = `${(userData.youtubePoints / 1) * 100}%`;
                document.getElementById('vip-progress').style.width = `${(userData.vipPoints / 200) * 100}%`;
                document.getElementById('referral-progress').style.width = `${(userData.referralPoints / 25) * 100}%`;
            }
        }
    </script>
</head>
<body>
