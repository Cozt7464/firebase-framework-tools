// عناصر DOM
const loginPage = document.getElementById('login-page');
const mainPage = document.getElementById('main-page');
const googleLoginButton = document.getElementById('google-login');
const sideMenuButton = document.getElementById('side-menu-button');
const sideMenu = document.getElementById('side-menu');
const closeSideMenuButton = document.getElementById('close-side-menu-button');
const pages = document.querySelectorAll('.page');
const pageTitle = document.getElementById('page-title');
const adVideo = document.getElementById('ad-video');

// قائمة فيديوهات إعلانات
const adVideos = [
    "https://www.youtube.com/embed/dQw4w9WgXcQ", // فيديو 1
    "https://www.youtube.com/embed/y6120QOlsfU", // فيديو 2
    "https://www.youtube.com/embed/6_b7RDuLwcI"  // فيديو 3
];

// تغيير الفيديو كل 5 دقائق
let currentAdIndex = 0;
function changeAdVideo() {
    currentAdIndex = (currentAdIndex + 1) % adVideos.length;
    adVideo.src = adVideos[currentAdIndex];
}
setInterval(changeAdVideo, 300000); // 5 دقائق

// وظيفة إظهار/إخفاء القائمة الجانبية
sideMenuButton.addEventListener('click', () => {
    sideMenu.classList.remove('hidden');
});

closeSideMenuButton.addEventListener('click', () => {
    sideMenu.classList.add('hidden');
});

// وظيفة تغيير الصفحة
function showPage(pageId) {
    pages.forEach(page => {
        if (page.id === pageId) {
            page.classList.remove('hidden');
            const pageTitleElement = page.querySelector('h2');
            if (pageTitleElement) {
                pageTitle.textContent = pageTitleElement.textContent;
            } else {
                pageTitle.textContent = "الصفحة الرئيسية"; // عنوان افتراضي
            }
        } else {
            page.classList.add('hidden');
        }
    });
}

// إظهار الصفحات عند النقر على الأزرار
document.getElementById('stats-button').addEventListener('click', () => {
    showPage('stats-page');
    sideMenu.classList.add('hidden');
});

document.getElementById('payment-menu-button').addEventListener('click', () => {
    showPage('payment-page');
    sideMenu.classList.add('hidden');
});

document.getElementById('vip-menu-button').addEventListener('click', () => {
    showPage('vip-page');
    sideMenu.classList.add('hidden');
});

document.getElementById('daily-tasks-button').addEventListener('click', () => {
    showPage('daily-tasks-page');
    sideMenu.classList.add('hidden');
});

document.getElementById('leaderboard-button').addEventListener('click', () => {
    showPage('leaderboard-page');
    sideMenu.classList.add('hidden');
});

document.getElementById('games-button').addEventListener('click', () => {
    showPage('games-page');
    sideMenu.classList.add('hidden');
});

// وظيفة طلب الدفع
document.getElementById('payment-form').addEventListener('submit', (e) => {
    e.preventDefault();
    const email = "choukrymohamed16@gmail.com";
    const subject = "طلب دفع جديد";
    const body = `
        إسم التطبيق: ${document.getElementById('app-name').value}
        الإسم الشخصي: ${document.getElementById('first-name').value}
        الإسم العائلي: ${document.getElementById('last-name').value}
        رقم الهاتف: ${document.getElementById('phone-number').value}
        رقم البطاقة الوطنية: ${document.getElementById('national-id').value}
        رقم التعريفي: ${document.getElementById('user-id').value}
        الحساب البنكي: ${document.getElementById('bank-account').value}
        البريد الإلكتروني: ${document.getElementById('user-email').value}
    `;
    window.open(`mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`);
    showNotification('تم إرسال طلب الدفع بنجاح!');
});

// وظيفة الدفع عبر PayPal
document.getElementById('vip-form').addEventListener('submit', (e) => {
    e.preventDefault();
    showNotification('تمت إضافة نقاط VIP بعد التحقق من الدفع!');
});

// وظيفة تحميل الوثيقة
document.getElementById('download-receipt').addEventListener('click', () => {
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF();
    doc.text("وثيقة دفع VIP", 10, 10);
    doc.text(`الإسم الشخصي: ${document.getElementById('vip-first-name').value}`, 10, 20);
    doc.text(`الإسم العائلي: ${document.getElementById('vip-last-name').value}`, 10, 30);
    doc.text(`البريد الإلكتروني: ${document.getElementById('vip-email').value}`, 10, 40);
    doc.text(`الرقم التعريفي: ${document.getElementById('vip-id-number').value}`, 10, 50);
    doc.text(`رقم .ط .و. : ${document.getElementById('vip-passport-number').value}`, 10, 60);
    doc.text(`تاريخ الإزدياد: ${document.getElementById('vip-birthdate').value}`, 10, 70);
    doc.text(`بريد المستخدم بايبال: ${document.getElementById('vip-paypal-email').value}`, 10, 80);
    doc.save('وثيقة_دفع_VIP.pdf');
    showNotification('تم تحميل الوثيقة بنجاح!');
});

// وظيفة إظهار الإشعارات
function showNotification(message) {
    const notification = document.getElementById('notification');
    const notificationMessage = document.getElementById('notification-message');
    notificationMessage.textContent = message;
    notification.classList.remove('hidden');
    setTimeout(() => {
        notification.classList.add('hidden');
    }, 3000);
}

// إشعار ترحيبي
function showWelcomeNotification() {
    showNotification('مرحبًا بك في تطبيق الربح من الإعلانات!');
}






body {
    font-family: Arial, sans-serif;
    direction: rtl;
    text-align: right;
    margin: 0;
    padding: 0;
    background-color: #f9f9f9; /* لون خلفية فاتح */
}

.hidden {
    display: none;
}

#login-page, #main-page {
    padding: 20px;
    text-align: center;
}

/* الشريط العلوي */
.top-bar {
    background-color: #ff0000; /* أحمر يوتيوب */
    color: white;
    padding: 10px;
    display: flex;
    justify-content: space-between;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
}

#side-menu-button {
    background-color: transparent;
    border: none;
    color: white;
    font-size: 24px;
    cursor: pointer;
}

#search-bar {
    width: 80%;
    padding: 10px;
    border: none;
    border-radius: 5px;
    font-size: 16px;
}

/* القائمة الجانبية */
#side-menu {
    position: fixed;
    top: 0;
    right: 0;
    background-color: #282828; /* أسود داكن */
    color: white;
    padding: 20px;
    width: 250px;
    height: 100%;
    box-shadow: -2px 0 5px rgba(0, 0, 0, 0.1);
    z-index: 1000;
}

#side-menu button {
    display: block;
    width: 100%;
    margin: 10px 0;
    padding: 10px;
    background-color: #ff0000; /* أحمر يوتيوب */
    color: white;
    border: none;
    border-radius: 5px;
    cursor: pointer;
}

#side-menu button:hover {
    background-color: #cc0000; /* أحمر داكن */
}

/* الصفحات */
.page {
    background-color: white;
    padding: 15px;
    border-radius: 10px;
    margin: 20px 0;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
}

.page h2 {
    margin-top: 0;
    color: #ff0000; /* أحمر يوتيوب */
}

.page label {
    display: block;
    margin: 10px 0 5px;
    font-weight: bold;
}

.page input {
    width: 100%;
    padding: 10px;
    margin-bottom: 10px;
    border: 1px solid #ccc;
    border-radius: 5px;
}

.page button {
    margin: 10px 0;
    padding: 10px;
    background-color: #ff0000; /* أحمر يوتيوب */
    color: white;
    border: none;
    border-radius: 5px;
    cursor: pointer;
}

.page button:hover {
    background-color: #cc0000; /* أحمر داكن */
}

/* الإشعارات */
#notification {
    position: fixed;
    bottom: 100px;
    right: 20px;
    background-color: #282828; /* أسود داكن */
    color: white;
    padding: 10px;
    border-radius: 5px;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
}

#notification-message {
    margin: 0;
}

/* فيديوهات الإعلانات */
#ad-videos {
    margin: 20px 0;
}

#ad-video {
    width: 100%;
    height: 315px;
    border-radius: 10px;
}

/* أشرطة التقدم */
.progress-bar {
    width: 100%;
    background-color: #e0e0e0;
    border-radius: 5px;
    margin-bottom: 10px;
}

.progress {
    height: 20px;
    background-color: #ff0000; /* أحمر يوتيوب */
    border-radius: 5px;
    width: 0%;
    transition: width 0.5s ease;
}

/* لوحة المتصدرين */
#leaderboard-list {
    list-style-type: none;
    padding: 0;
}

#leaderboard-list li {
    margin: 10px 0;
    padding: 10px;
    background-color: #f4f4f4;
    border-radius: 5px;
    box-shadow: 0 0 5px rgba(0, 0, 0, 0.1);
}







